# =============================================================================
# Application
# =============================================================================
# development | production
APP_ENV=development
APP_PORT=8002
# Reverse proxy prefix. Use an empty value when exposing Uvicorn directly.
ROOT_PATH=/gaim
SECRET_KEY=replace-with-random-secret
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# =============================================================================
# WAS (Backend) Integration
# =============================================================================
WAS_BASE_URL=http://localhost:8080
WAS_INTERNAL_TOKEN=change-this-internal-token
WAS_CALLBACK_TIMEOUT_SEC=5.0

# =============================================================================
# AI Provider
# =============================================================================
# mock | live
AI_PROVIDER_MODE=mock

# =============================================================================
# OpenAI
# =============================================================================
OPENAI_API_KEY=sk-local-placeholder

# Available models
OPENAI_IMAGE_MODELS=["gpt-image-2","gpt-image-1.5","gpt-image-1","gpt-image-1-mini"]

# Default
OPENAI_DEFAULT_IMAGE_MODEL=gpt-image-1.5
OPENAI_DEFAULT_IMAGE_QUALITY=low
OPENAI_PROVIDER_TIMEOUT_SEC=60

# Role-based model mapping
OPENAI_QUALITY_IMAGE_MODEL=gpt-image-2
OPENAI_STANDARD_IMAGE_MODEL=gpt-image-1.5
OPENAI_FAST_IMAGE_MODEL=gpt-image-1-mini
OPENAI_EDIT_IMAGE_MODEL=gpt-image-2
OPENAI_TEXT_ACCURACY_IMAGE_MODEL=gpt-image-2

# =============================================================================
# Google / GCP
# =============================================================================
GOOGLE_API_KEY=google-local-placeholder
# api_key | vertex_ai
GOOGLE_AUTH_MODE=api_key
GCP_PROJECT_ID=local-gcp-project
GCP_LOCATION=us-central1
GCP_SERVICE_ACCOUNT_JSON='{}'

# Timeout settings
GOOGLE_PROVIDER_TIMEOUT_MS=60000

# Image
GOOGLE_IMAGE_MODELS=["gemini-2.5-flash-image"]
GOOGLE_DEFAULT_IMAGE_MODEL=gemini-2.5-flash-image
GCP_IMAGE_LOCATION=global

# Video
GOOGLE_VIDEO_MODELS=["veo-3.1-fast-generate-001","veo-3.1-generate-001","veo-3.1-lite-generate-001"]
GOOGLE_DEFAULT_VIDEO_MODEL=veo-3.1-fast-generate-001
GOOGLE_FAST_VIDEO_MODEL=veo-3.1-fast-generate-001
GOOGLE_STANDARD_VIDEO_MODEL=veo-3.1-generate-001
GOOGLE_LITE_VIDEO_MODEL=veo-3.1-lite-generate-001
GCP_VIDEO_LOCATION=us-central1

# =============================================================================
# Runway fallback for video
# =============================================================================
# Runway 공식 SDK/문서에서 사용하는 이름입니다. 로컬 .env에 실제 키를 넣으세요.
RUNWAYML_API_SECRET=runway-local-placeholder
RUNWAY_VIDEO_MODELS=["gen4.5","gen4_turbo"]
RUNWAY_FAST_VIDEO_MODEL=gen4_turbo
RUNWAY_STANDARD_VIDEO_MODEL=gen4.5
RUNWAY_API_BASE_URL=https://api.dev.runwayml.com/v1
RUNWAY_API_VERSION=2024-11-06
RUNWAY_REQUEST_TIMEOUT_SEC=30
RUNWAY_DOWNLOAD_TIMEOUT_SEC=60

VIDEO_POLL_INTERVAL_SEC=10
VIDEO_MAX_WAIT_SEC=600

# =============================================================================
# Storage
# =============================================================================
# local | gcs
STORAGE_BACKEND=local
STORAGE_BASE_DIR=../storage-data
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8002/gaim/generated
GCS_BUCKET_NAME=gaim-generated-assets

# Storage timeout and size settings
LOCAL_STORAGE_RETENTION_SECONDS=604800
MAX_IMAGE_REFERENCE_BYTES=10485760
MAX_VIDEO_INPUT_IMAGE_BYTES=10485760
REFERENCE_IMAGE_DOWNLOAD_TIMEOUT_SEC=20

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Docker Compose 내부에서는 localhost 대신 service hostname(redis)을 써야 한다.
DOCKER_REDIS_URL=redis://redis:6379/0
DOCKER_CELERY_BROKER_URL=redis://redis:6379/0
DOCKER_CELERY_RESULT_BACKEND=redis://redis:6379/1

REDIS_APPENDONLY=yes
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=noeviction
REDIS_DATA_VOLUME=gaim-ai-engine-redis-data
# 서버의 특정 디렉터리를 직접 마운트해야 할 때만 사용한다. 로컬 MVP 기본값은 named volume이다.
REDIS_DATA_DIR=

# Resource retention / TTL summary:
# - CELERY_RESULT_EXPIRES: Redis result backend TTL
# - JOB_STATUS_TTL_SECONDS: jobId -> Celery taskId/status fallback mapping TTL
# - JOB_TERMINAL_STATUS_TTL_SECONDS: completed/failed job result fallback TTL
# - CELERY_JOB_LOCK_TTL: duplicate execution prevention lock TTL
# - LOCAL_STORAGE_RETENTION_SECONDS: generated local file retention TTL

# Redis auth 사용 시 `openssl rand -hex 32`처럼 URL-safe password를 만들고 URL 3개를 함께 바꾼다.
# REDIS_REQUIREPASS=your-hex-password
# REDIS_URL=redis://:your-hex-password@localhost:6379/0
# CELERY_BROKER_URL=redis://:your-hex-password@localhost:6379/0
# CELERY_RESULT_BACKEND=redis://:your-hex-password@localhost:6379/1
# DOCKER_REDIS_URL=redis://:your-hex-password@redis:6379/0
# DOCKER_CELERY_BROKER_URL=redis://:your-hex-password@redis:6379/0
# DOCKER_CELERY_RESULT_BACKEND=redis://:your-hex-password@redis:6379/1
REDIS_REQUIREPASS=
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=5
CELERY_IMAGE_WORKER_CONCURRENCY=5
CELERY_VIDEO_WORKER_CONCURRENCY=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=660
CELERY_TASK_TIME_LIMIT=720
CELERY_RESULT_EXPIRES=3600
CELERY_BROKER_VISIBILITY_TIMEOUT=900
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_REJECT_ON_WORKER_LOST=true
CELERY_TASK_ACKS_ON_FAILURE_OR_TIMEOUT=true
CELERY_TASK_RETRY_ENABLED=false
CELERY_TASK_RETRY_COUNTDOWN=15
CELERY_JOB_LOCK_TTL=900
CELERY_JOB_LOCK_ENABLED=true

JOB_STATUS_TTL_SECONDS=43200
JOB_TERMINAL_STATUS_TTL_SECONDS=86400

# =============================================================================
# Logging
# =============================================================================
AI_GENERATION_TIMING_LOG_ENABLED=false
AI_GENERATION_TIMING_LOG_FILE=logs/ai-generation-timing.log
