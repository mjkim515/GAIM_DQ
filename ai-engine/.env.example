# =============================================================================
# Application
# =============================================================================
APP_ENV=development
APP_PORT=8002
# Reverse proxy prefix. Use an empty value when exposing Uvicorn directly.
ROOT_PATH=/gaim
SECRET_KEY=replace-with-random-secret
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# =============================================================================
# WAS (Backend) Integration
# =============================================================================
WAS_BASE_URL=http://localhost:8080
WAS_INTERNAL_TOKEN=change-this-internal-token
WAS_CALLBACK_TIMEOUT_SEC=1.0

# =============================================================================
# AI Provider
# =============================================================================
# mock | live
AI_PROVIDER_MODE=mock

# =============================================================================
# OpenAI
# =============================================================================
OPENAI_API_KEY=sk-local-placeholder

# Available models
OPENAI_IMAGE_MODELS=["gpt-image-2","gpt-image-1.5","gpt-image-1","gpt-image-1-mini"]

# Default
OPENAI_DEFAULT_IMAGE_MODEL=gpt-image-1.5
OPENAI_DEFAULT_IMAGE_QUALITY=low

# Role-based model mapping
OPENAI_QUALITY_IMAGE_MODEL=gpt-image-2
OPENAI_STANDARD_IMAGE_MODEL=gpt-image-1.5
OPENAI_FAST_IMAGE_MODEL=gpt-image-1-mini
OPENAI_EDIT_IMAGE_MODEL=gpt-image-2
OPENAI_TEXT_ACCURACY_IMAGE_MODEL=gpt-image-2

# =============================================================================
# Google / GCP
# =============================================================================
GOOGLE_API_KEY=google-local-placeholder
# api_key | service_account
GOOGLE_AUTH_MODE=api_key
GCP_PROJECT_ID=local-gcp-project
GCP_LOCATION=us-central1
GCP_SERVICE_ACCOUNT_JSON='{}'

# Image
GOOGLE_IMAGE_MODELS=["gemini-2.5-flash-image"]
GOOGLE_DEFAULT_IMAGE_MODEL=gemini-2.5-flash-image
GCP_IMAGE_LOCATION=global

# Video
GOOGLE_VIDEO_MODELS=["veo-3.1-fast-generate-001","veo-3.1-generate-001","veo-3.1-lite-generate-001"]
GOOGLE_DEFAULT_VIDEO_MODEL=veo-3.1-fast-generate-001
GOOGLE_FAST_VIDEO_MODEL=veo-3.1-fast-generate-001
GOOGLE_STANDARD_VIDEO_MODEL=veo-3.1-generate-001
GOOGLE_LITE_VIDEO_MODEL=veo-3.1-lite-generate-001
GCP_VIDEO_LOCATION=us-central1

# =============================================================================
# Runway fallback for video
# =============================================================================
# Runway 공식 SDK/문서에서 사용하는 이름입니다. 로컬 .env에 실제 키를 넣으세요.
RUNWAYML_API_SECRET=runway-local-placeholder
RUNWAY_VIDEO_MODELS=["gen4.5","gen4_turbo"]
RUNWAY_FAST_VIDEO_MODEL=gen4_turbo
RUNWAY_STANDARD_VIDEO_MODEL=gen4.5
RUNWAY_API_BASE_URL=https://api.dev.runwayml.com/v1
RUNWAY_API_VERSION=2024-11-06

VIDEO_POLL_INTERVAL_SEC=10
VIDEO_MAX_WAIT_SEC=600

# =============================================================================
# Storage
# =============================================================================
# local | gcs
STORAGE_BACKEND=local
STORAGE_BASE_DIR=../storage-data
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8002/gaim/generated
GCS_BUCKET_NAME=gaim-generated-assets

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=5

# =============================================================================
# Logging
# =============================================================================
AI_GENERATION_TIMING_LOG_ENABLED=false
AI_GENERATION_TIMING_LOG_FILE=logs/ai-generation-timing.log
